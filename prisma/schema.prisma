datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  phone        String?
  role         String        @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  addressLine String
  city        String
  state       String
  postalCode  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  shortDescription String
  fullDescription  String
  sku              String      @unique
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  price            Int // in INR (Rupees)
  originalPrice    Int? // in INR (Rupees)
  image            String
  ingredients      String // Comma separated or detailed description
  weight           String // e.g. "350g", "400g"
  stock            Int         @default(100)
  isFeatured       Boolean     @default(false)
  isBestseller     Boolean     @default(false)
  isPublished      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
  reviews          Review[]
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  guestEmail         String?
  guestName          String?
  guestPhone         String?
  shippingAddress    String // Formatted address string or JSON
  subtotal           Int // in Rupees
  discount           Int         @default(0)
  shippingFee        Int         @default(0)
  total              Int // in Rupees
  status             String      @default("PENDING_PAYMENT") // PENDING_PAYMENT | CONFIRMED | PROCESSING | PACKED | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentMethod      String      @default("COD") // COD | RAZORPAY
  paymentStatus      String      @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  razorpayOrderId    String?
  razorpayPaymentId  String?
  trackingNumber     String?
  courierName        String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  productImage String
  price        Int
  quantity     Int
  total        Int
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String // PERCENTAGE | FIXED
  discountValue  Int
  minOrderAmount Int       @default(0)
  maxDiscount    Int?
  maxUses        Int       @default(100)
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  userName           String
  userAvatar         String?
  rating             Int      @default(5)
  comment            String
  isApproved         Boolean  @default(true)
  isVerifiedPurchase Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorEmail String
  details    String
  createdAt  DateTime @default(now())
}

model HeroContent {
  id               String   @id @default("default")
  eyebrow          String
  heading          String
  malayalamText    String
  description      String
  primaryBtnText   String
  primaryBtnLink   String
  secondaryBtnText String
  secondaryBtnLink String
  heroImage        String
  badgeText        String
  isActive         Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt
}

model Benefit {
  id             String   @id @default(uuid())
  title          String
  malayalamTitle String
  subtitle       String
  icon           String
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
}

model StoryContent {
  id               String   @id @default("default")
  eyebrow          String
  heading          String
  malayalamHeading String
  description      String
  quoteText        String
  image            String
  ctaText          String
  ctaUrl           String
  decorativeText   String
  isActive         Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt
}

model Ingredient {
  id            String   @id @default(uuid())
  name          String
  malayalamName String
  description   String
  image         String
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
}

model PromoBanner {
  id            String   @id @default("default")
  eyebrow       String
  heading       String
  malayalamText String
  description   String
  ctaText       String
  ctaUrl        String
  image         String
  isActive      Boolean  @default(true)
  updatedAt     DateTime @default(now()) @updatedAt
}

model NavigationItem {
  id           String   @id @default(uuid())
  label        String
  url          String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model FooterSetting {
  id               String   @id @default("default")
  description      String
  malayalamTagline String
  instagramUrl     String?
  facebookUrl      String?
  youtubeUrl       String?
  pinterestUrl     String?
  copyrightText    String
  updatedAt        DateTime @default(now()) @updatedAt
}

model FAQ {
  id           String   @id @default(uuid())
  question     String
  answer       String
  category     String   @default("General")
  displayOrder     Int      @default(0)
  isActive     Boolean  @default(true)
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         String   @default("ADMIN")
  permissions  String   @default("*")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PolicyPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model InventoryMovement {
  id          String   @id @default(uuid())
  productId   String
  changeType  String
  quantity    Int
  reason      String
  createdBy   String
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  actorEmail  String
  details     String
  ipAddress   String?
  createdAt   DateTime @default(now())
}

